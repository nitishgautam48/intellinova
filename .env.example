# ---- Required secrets (generate with: openssl rand -hex 32) ----
POSTGRES_PASSWORD=change-me
GOTRUE_DB_PASSWORD=change-me-too
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
MEILI_MASTER_KEY=change-me-meili-key

# ---- Public address ----
# Where people reach the site. Used for email links and OAuth redirects.
PUBLIC_URL=http://localhost
# ":80" for plain HTTP; set to your domain (e.g. learn.example.org) for automatic HTTPS.
SITE_ADDRESS=:80
# Set to true once you serve over HTTPS.
COOKIE_SECURE=false

# ---- Admin console access ----
# Recommended in production: the first admin sign-up (/admin/signup) must enter this token.
# Everyone after that joins by invite from an admin.
ADMIN_BOOTSTRAP_TOKEN=
INVITE_TTL_DAYS=7

# ---- Email (GoTrue sends sign-up codes and password resets) ----
# Defaults point at the Mailpit dev container: docker compose --profile dev up -d
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@intellinova.local
# true = skip email verification (only for local testing)
MAILER_AUTOCONFIRM=false

# ---- Optional sign-in methods ----
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PHONE_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=

# ---- AI models (pulled into the ollama container) ----
LLM_MODEL=llama3.1:8b
# Second model: checks generated questions and judges evaluation runs. A reasoning model such as
# deepseek-r1:7b also works here (its <think> section is removed automatically); it is slower.
VERIFIER_MODEL=qwen2.5:7b
VISION_MODEL=llava:7b
# Context window sent to Ollama (tokens). Ollama's own default is small and cuts long prompts off.
# 8192 fits an 8 GB GPU with a 7-8B model; use 4096 if answers get slow on a smaller GPU.
LLM_NUM_CTX=8192
# How long Ollama keeps a model loaded after the last request (avoids reloading it for every question).
LLM_KEEP_ALIVE=30m
# Multilingual cross-encoder that re-orders retrieved passages before answering (better context
# precision, ~0.5 GB RAM, CPU). Leave empty to turn re-ranking off on low-memory machines.
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Download the English and Hindi Piper voices (~120 MB) on first start, for spoken answers.
PIPER_AUTO_DOWNLOAD=true
# sentence-transformers | ollama
EMBEDDINGS_BACKEND=sentence-transformers
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
WHISPER_MODEL=small
WORKER_CONCURRENCY=2

# ---- YouTube video discovery ----
# When a topic has fewer than DISCOVERY_MIN_VIDEOS videos, IntelliNova searches YouTube, checks each result
# against the syllabus with the local AI and adds the best DISCOVERY_MAX_RESULTS, marked "Auto-found".
# With YOUTUBE_API_KEY (free, 10,000 units/day ~ 95 searches) it uses the official API with SafeSearch;
# without a key it falls back to yt-dlp. Results are cached per topic for 14 days.
YOUTUBE_API_KEY=
DISCOVERY_ENABLED=true
DISCOVERY_MIN_VIDEOS=3
DISCOVERY_MAX_RESULTS=5

# ---- Optional Reddit signal (off unless both keys are set; free tier is non-commercial only) ----
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=CBSE+JEENEETards+Indian_Academia+IndianStudents+ICSE

# ---- Optional signals ----
POSTHOG_HOST=
POSTHOG_API_KEY=
